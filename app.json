{
  "expo": {
    "name": "BMG Digi Schemes",
    "slug": "bmg-scheme",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "NOTIFICATIONS",
        "com.google.android.c2dm.permission.RECEIVE",
        "WAKE_LOCK",
        "VIBRATE"
      ],
      "versionCode": 24,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.bmg.bmgscheme"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a2916d84-f040-424a-805e-0be799d7a6ff"
      }
    },
    "owner": "brightech",
    "plugins": [
      "expo-font",
      "expo-localization"
    ]
  }
}
