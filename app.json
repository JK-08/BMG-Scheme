{
  "expo": {
    "name": "BMG Digi Schemes",
    "slug": "bmg-scheme",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "versionCode": 50,
      "package": "com.bmg.bmgscheme",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a2916d84-f040-424a-805e-0be799d7a6ff"
      }
    },
    "owner": "brightech",
    "plugins": [
      "./plugins/withFirebaseNotificationChannel",
      "expo-font",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow camera access to take a profile photo."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "androidMode": "default"
        }
      ]
    ]
  }
}
